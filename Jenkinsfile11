pipeline {
  agent any

  stages {
      stage('Build') {
      steps {
            // Run the Django server in the foreground
            sh 'python3 manage.py' 
            echo 'Django server started. Proceeding to next stage...'
      }
    }

    stage('Deploy') {
      steps {
        // Build the image
        sh 'docker build -t todo .'
        
        // Run the container with a specific name (e.g., 'todo_container')
        sh 'docker run -d -p 8000:8000 --name todo_container todo'
      }
      post {
        always {
          echo 'Waiting for 2 minutes before stopping and deleting containers...'
          // Sleep for 2 minutes before stopping and deleting containers
          sleep 2

          // Stop the container using its name
          echo 'Stopping container...'
          sh 'docker stop todo_container'

          // Remove the container
          echo 'Removing container...'
          sh 'docker rm todo_container'
        }
      }
    }
  }
}
